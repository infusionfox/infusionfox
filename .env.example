# ---------------------------------------------------------------------------
# InfusionFox configuration
# Copy to `.env` before running `docker compose up`.
# ---------------------------------------------------------------------------

# Host port the container is exposed on (dev compose only — prod uses Cloudflare Tunnel, no host port).
INFUSIONFOX_PORT=8765

# Admin bootstrap token (remove after promoting your user to admin once)
# INFUSIONFOX_ADMIN_TOKEN=pick-a-long-random-string

# UI feature flag: show /pricing, /auth/login, /account links in the
# top nav, hero CTA, and footer. Default off ("0") for the private-beta
# phase where access is gated by Cloudflare Zero Trust. Set to "1" when
# ready to expose pricing and self-serve registration publicly.
# INFUSIONFOX_SHOW_AUTH_PRICING_UI=0

# ---- Production only ----
# Cloudflare Tunnel token (from Cloudflare → Zero Trust → Networks → Tunnels)
# CLOUDFLARE_TUNNEL_TOKEN=

# ---- Pass 3b (email sending) ----
# RESEND_API_KEY=re_...
# INFUSIONFOX_EMAIL_FROM=InfusionFox <noreply@infusionfox.com>

# ---- Pass 4 (Stripe) ----
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_PRICE_STUDENT_MONTHLY=price_...
# STRIPE_PRICE_STUDENT_YEARLY=price_...

# ---- Pass 5 (webinars via Mux) ----
# MUX_TOKEN_ID=...
# MUX_TOKEN_SECRET=...
# MUX_SIGNING_KEY_ID=...
# MUX_SIGNING_KEY_PRIVATE=...
